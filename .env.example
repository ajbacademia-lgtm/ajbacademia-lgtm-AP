# ==============================================================================
# Academic Publishing Group (AJP) - Production Environment Variables
# Hostinger VPS / Cloud / Managed Node.js App Configuration
# ==============================================================================

# Node Environment & Port
NODE_ENV=production
PORT=3000

# ==============================================================================
# Hostinger MySQL Database Configuration
# ==============================================================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=u123456789_ajp_db
DB_USER=u123456789_ajp_user
DB_PASSWORD=your_secure_mysql_password_here

# ==============================================================================
# Authentication & JWT Security Configuration
# ==============================================================================
# Generate a 64-character high-entropy secret in production (e.g. openssl rand -base64 48)
JWT_SECRET=replace_with_a_cryptographically_secure_random_string_in_production
JWT_EXPIRES_IN=2h
REFRESH_EXPIRES_IN=7d

# Initial Admin Account Bootstrap (Optional: Auto-seeds initial admin if database is empty)
ADMIN_BOOTSTRAP_EMAIL=admin@journal.org
ADMIN_BOOTSTRAP_PASSWORD=change_this_admin_password_on_first_login

# ==============================================================================
# Local File Storage Configuration
# ==============================================================================
# Custom base directory for persistent file storage (defaults to ./uploads)
# Segregated into /uploads/public and /uploads/private (outside webroot)
STORAGE_BASE_DIR=

# ==============================================================================
# Optional AI Assistant API Key
# ==============================================================================
GEMINI_API_KEY=
