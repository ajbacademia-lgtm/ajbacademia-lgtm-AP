# ==============================================================================
# Academic Journal Platform (AJP) - Environment Variable Template
# Copy this file to .env and provide your environment-specific values.
# ==============================================================================

# ------------------------------------------------------------------------------
# Runtime Configuration
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# ------------------------------------------------------------------------------
# Database (MySQL Connection Pool)
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=westbrid_academic
DB_USERNAME=westbrid_academic
DB_PASSWORD=
# Note: DB_NAME and DB_USER are also accepted as aliases for DB_DATABASE and DB_USERNAME

# ------------------------------------------------------------------------------
# Authentication (JWT Security & Token Expiry)
# ------------------------------------------------------------------------------
# High-entropy random string for HS256 JWT signature verification
JWT_SECRET=x9K#mP7$vL2@qR8#nF4wY6%hB1!dC3&jT5-zX9*pK2mN88f4k2m9x7q5p3z1
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# Administrator Bootstrap (Initial Admin Seed)
# ------------------------------------------------------------------------------
# When provided, seeds or activates the primary administrator account safely
ADMIN_BOOTSTRAP_EMAIL=admin@academicpublishinggroup.org
ADMIN_BOOTSTRAP_PASSWORD=MA4598@HFbs40#@#

# ------------------------------------------------------------------------------
# File Storage (Persistent Manuscript & Asset Storage)
# ------------------------------------------------------------------------------
# Absolute path or relative directory for file uploads (defaults to storage/upload)
STORAGE_BASE_DIR=storage/upload

# ------------------------------------------------------------------------------
# Optional External Services
# ------------------------------------------------------------------------------
# Optional API key for conversational AI reviewer & assistant capabilities
GEMINI_API_KEY=
