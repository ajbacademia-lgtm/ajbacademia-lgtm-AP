# ====================================================================
# Academic Journal Platform (AJP) - Production Web Server Configuration
# ====================================================================

# Set Default Directory Index
DirectoryIndex index.html

# URL Rewriting & Reverse Proxy / SPA Routing
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. NEVER rewrite API requests to index.html - pass directly to Node.js backend
  RewriteCond %{REQUEST_URI} ^/api [NC]
  RewriteRule ^ - [L]

  # 2. Serve static physical files and directories directly if they exist
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d [OR]
  RewriteCond %{REQUEST_FILENAME} -l
  RewriteRule ^ - [L]

  # 3. Route all remaining client-side React requests to index.html
  RewriteRule ^ index.html [L]
</IfModule>

# Security Headers & MIME Types
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
</IfModule>
